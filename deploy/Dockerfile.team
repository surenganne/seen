# Seen team server (Phase 5 skeleton). Postgres-backed; runs as a non-root user.
FROM python:3.12.15-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY pricing/ pricing/
COPY packages/ packages/
RUN uv sync --frozen --no-dev --no-editable --package seen-team
COPY tests/ tests/
COPY deploy/healthcheck.py /usr/local/bin/seen-team-health
RUN useradd --uid 10002 --create-home seen && chown -R seen /app
USER seen
ENV PATH=/app/.venv/bin:$PATH SEEN_TEAM_HOST=0.0.0.0 SEEN_TEAM_PORT=47824 APP_ENV=production
EXPOSE 47824
HEALTHCHECK --interval=10s --timeout=3s --retries=12 CMD ["python", "/usr/local/bin/seen-team-health"]
CMD ["python", "-m", "seen_team.app"]
