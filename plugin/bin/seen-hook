#!/bin/sh
# Seen hook shim. The hook code ships in seen-cli (stdlib only); this finds it.
# Fails open: if seen-cli is missing, log it and exit 0 so Claude Code is never blocked.
if [ -n "$SEEN_HOOK_BIN" ] && [ -x "$SEEN_HOOK_BIN" ]; then exec "$SEEN_HOOK_BIN" "$@"; fi
if command -v seen-hook >/dev/null 2>&1; then exec seen-hook "$@"; fi
if [ -x "$HOME/.local/bin/seen-hook" ]; then exec "$HOME/.local/bin/seen-hook" "$@"; fi
log="${SEEN_HOME:-$HOME/.seen}/log"
mkdir -p "$log" 2>/dev/null && echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $1: seen-hook not found; run: uv tool install git+https://github.com/surenganne/seen#subdirectory=packages/cli" >> "$log/hook.log"
cat >/dev/null
if [ "$1" = "session-start" ]; then
  printf '%s' '{"systemMessage":"Seen: seen-cli is not installed, so this session is not recorded. Run: uv tool install git+https://github.com/surenganne/seen#subdirectory=packages/cli"}'
fi
exit 0
